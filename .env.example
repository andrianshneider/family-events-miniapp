# Copy to .env.local (ignored). Set all values separately in Vercel Preview and Production.
APP_ENV=local
APP_URL=http://localhost:3000
# Runtime PostgreSQL LOGIN role: member of fe_server, NOT postgres/service_role; transaction pooler supported.
DATABASE_URL=
# Migration owner/admin connection. Never used by Next.js runtime.
DATABASE_ADMIN_URL=
# Dedicated LOGIN role member of fe_worker. Only exposed worker functions.
DATABASE_WORKER_URL=
DATABASE_SSL=true
# Base64 PEM root CA downloaded from the Supabase dashboard/vendor; keeps certificate verification enabled.
DATABASE_CA_CERT_BASE64=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=event-media
# Independent random 32-byte base64 values. Generate with node crypto.randomBytes(32).
SESSION_SECRET=
AUTH_ENCRYPTION_KEY=
RATE_LIMIT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
# IP header trusted only on Vercel; use fixed local key outside deployment.
AUTH_RATE_LIMIT=10
GUEST_SESSION_RATE_LIMIT=20
PUBLIC_READ_RATE_LIMIT=120

# Explicit opt-in P0 analytics. Server only; production is hard-disabled.
ANALYTICS_ENABLED=false
POSTHOG_ENVIRONMENT=non-production
# Choose the actual project's EU/US ingestion host; no default region.
POSTHOG_HOST=
POSTHOG_PROJECT_KEY=
# Local builds may specify a commit SHA; Vercel uses VERCEL_GIT_COMMIT_SHA.
APP_VERSION=
